{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@applemusic-like-lyrics/core": [
        "../applemusic-like-lyrics/packages/core/dist/index.d.ts"
      ],
      "@applemusic-like-lyrics/core/style.css": [
        "../applemusic-like-lyrics/packages/core/dist/amll-core.css"
      ],
      "@applemusic-like-lyrics/lyric": [
        "../applemusic-like-lyrics/packages/lyric/pkg/amll_lyric.d.ts"
      ],
      "@applemusic-like-lyrics/ttml": [
        "../applemusic-like-lyrics/packages/ttml/dist/index.d.ts"
      ]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.contract.test.mts"
  ]
}
